Private Sub UpDown1_DownClick()
    If TxAño = 2012 Then
       Exit Sub
    End If
    For cont = Forms.Count - 1 To 0 Step -1
       If Forms(cont).Visible = False Then
       Else
          ' Form Abierto
          If Forms(cont).Name <> "CpMenu" Then
             Unload Forms(cont)
          End If
       End If
    Next
    
    TxAño = TxAño - 1
    wflg = "NO"
    w_ano = TxAño
    Call CompruebaTabla
    If wflg = "NO" Then
       TxAño = TxAño + 1
       Exit Sub
    End If
    
    genaño = Trim(TxAño)
    Me.Caption = "Menu Principal - " & genaño & "   -   Sesión: " + wUsuNombre
End Sub
Private Sub UpDown1_UpClick()
    For cont = Forms.Count - 1 To 0 Step -1
       If Forms(cont).Visible = False Then
       Else
          ' Form Abierto
          If Forms(cont).Name <> "CpMenu" Then
             Unload Forms(cont)
          End If
       End If
    Next
       
    TxAño = TxAño + 1
    wflg = "NO"
    w_ano = TxAño
    Call CompruebaTabla
    If wflg = "NO" Then
       TxAño = TxAño - 1
       Exit Sub
    End If
    
    genaño = Trim(TxAño)
    Me.Caption = "Menu Principal - " & genaño & "   -   Sesión: " + wUsuNombre
End Sub
